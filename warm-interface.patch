+
+    <Application.Resources>
+        <SolidColorBrush x:Key="WarmBackground">#F5F1EA</SolidColorBrush>
+        <SolidColorBrush x:Key="WarmSurface">#FFFCF7</SolidColorBrush>
+        <SolidColorBrush x:Key="WarmInset">#EFE8DE</SolidColorBrush>
+        <SolidColorBrush x:Key="WarmBorder">#DED5C9</SolidColorBrush>
+        <SolidColorBrush x:Key="WarmInk">#362D27</SolidColorBrush>
+        <SolidColorBrush x:Key="WarmMuted">#75685D</SolidColorBrush>
+        <SolidColorBrush x:Key="WarmAccent">#9C4933</SolidColorBrush>
+        <SolidColorBrush x:Key="WarmHover">#EDE2D5</SolidColorBrush>
+    </Application.Resources>
+
+    <Application.Styles>
+        <FluentTheme>
+            <FluentTheme.Palettes>
+                <ColorPaletteResources x:Key="Light" Accent="#9C4933" />
+            </FluentTheme.Palettes>
+        </FluentTheme>
+        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
+        <Style Selector="Window">
+            <Setter Property="Background" Value="{StaticResource WarmBackground}" />
+            <Setter Property="Foreground" Value="{StaticResource WarmInk}" />
+            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
+            <Setter Property="FontSize" Value="13" />
+        </Style>
+        <Style Selector="Button">
+            <Setter Property="Background" Value="{StaticResource WarmSurface}" />
+            <Setter Property="Foreground" Value="{StaticResource WarmInk}" />
+            <Setter Property="BorderBrush" Value="{StaticResource WarmBorder}" />
+            <Setter Property="BorderThickness" Value="1" />
+            <Setter Property="CornerRadius" Value="8" />
+            <Setter Property="Padding" Value="13,9" />
+            <Setter Property="MinHeight" Value="36" />
+            <Setter Property="HorizontalContentAlignment" Value="Center" />
+        </Style>
+        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
+            <Setter Property="Background" Value="{StaticResource WarmHover}" />
+            <Setter Property="BorderBrush" Value="{StaticResource WarmMuted}" />
+            <Setter Property="Foreground" Value="{StaticResource WarmInk}" />
+        </Style>
+        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
+            <Setter Property="Background" Value="{StaticResource WarmInset}" />
+            <Setter Property="Foreground" Value="{StaticResource WarmInk}" />
+        </Style>
+        <Style Selector="Button.primary">
+            <Setter Property="Background" Value="{StaticResource WarmAccent}" />
+            <Setter Property="BorderBrush" Value="{StaticResource WarmAccent}" />
+            <Setter Property="Foreground" Value="#FFFCF7" />
+        </Style>
+        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
+            <Setter Property="Background" Value="#803B29" />
+            <Setter Property="BorderBrush" Value="#803B29" />
+            <Setter Property="Foreground" Value="#FFFCF7" />
+        </Style>
+        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
+            <Setter Property="Background" Value="#693020" />
+            <Setter Property="Foreground" Value="#FFFCF7" />
+        </Style>
+        <Style Selector="Button.quiet">
+            <Setter Property="Background" Value="Transparent" />
+            <Setter Property="BorderBrush" Value="Transparent" />
+            <Setter Property="Foreground" Value="{StaticResource WarmMuted}" />
+        </Style>
+        <Style Selector="ComboBox">
+            <Setter Property="Background" Value="{StaticResource WarmSurface}" />
+            <Setter Property="BorderBrush" Value="{StaticResource WarmBorder}" />
+            <Setter Property="CornerRadius" Value="8" />
+            <Setter Property="MinHeight" Value="36" />
+            <Setter Property="HorizontalAlignment" Value="Stretch" />
+        </Style>
+        <Style Selector="Border.card">
+            <Setter Property="Background" Value="{StaticResource WarmSurface}" />
+            <Setter Property="BorderBrush" Value="{StaticResource WarmBorder}" />
+            <Setter Property="BorderThickness" Value="1" />
+            <Setter Property="CornerRadius" Value="14" />
+        </Style>
+        <Style Selector="TextBlock.eyebrow">
+            <Setter Property="Foreground" Value="{StaticResource WarmMuted}" />
+            <Setter Property="FontSize" Value="11" />
+            <Setter Property="FontWeight" Value="SemiBold" />
+            <Setter Property="LetterSpacing" Value="1.5" />
+        </Style>
+        <Style Selector="TextBlock.sectionTitle">
+            <Setter Property="FontSize" Value="15" />
+            <Setter Property="FontWeight" Value="SemiBold" />
+        </Style>
+        <Style Selector="TextBlock.muted">
+            <Setter Property="Foreground" Value="{StaticResource WarmMuted}" />
+            <Setter Property="FontSize" Value="12" />
+        </Style>
+    </Application.Styles>
+</Application>
