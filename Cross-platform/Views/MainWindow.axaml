<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TeachingAidMac.ViewModels"
        xmlns:controls="using:TeachingAidMac.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="TeachingAidMac.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1440" Height="900" MinWidth="1120" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Title="Graph Theory Teaching Aid">
    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,20,24,0">
        <!-- A quiet identity bar keeps file actions separate from the workspace. -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource WarmInset}" Margin="0,0,14,0">
                <Canvas Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Path Data="M7,8 L23,13 L11,24 Z" Stroke="{StaticResource WarmAccent}" StrokeThickness="1.5" />
                    <Ellipse Width="7" Height="7" Canvas.Left="3.5" Canvas.Top="4.5" Fill="{StaticResource WarmAccent}" />
                    <Ellipse Width="7" Height="7" Canvas.Left="19.5" Canvas.Top="9.5" Fill="{StaticResource WarmAccent}" />
                    <Ellipse Width="7" Height="7" Canvas.Left="7.5" Canvas.Top="20.5" Fill="{StaticResource WarmAccent}" />
                </Canvas>
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="Graph Theory" FontSize="23" FontWeight="SemiBold" />
                <TextBlock Text="A little exploration. A clearer connection." Classes="muted" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Name="LoadFileButton" Content="Load graph" />
                <Button Name="SaveGraphButton" Content="Save graph" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Classes="card" Padding="12,10" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,Auto">
                <WrapPanel Orientation="Horizontal">
                    <Button Name="AddNodeButton" Content="+ Add node" Classes="primary" Margin="0,0,8,0" />
                    <Button Name="RemoveNodeButton" Content="Remove node" Margin="0,0,8,0" />
                    <Button Name="LoadGraphButton" Content="Load sample graph" Margin="0,0,8,0" />
                    <Button Name="FullyConnectButton" Content="Fully connect" Margin="0,0,8,0" />
                    <Button Name="ClearGraphButton" Content="Clear graph" Classes="quiet" />
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{StaticResource WarmInset}" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="Weights:" Classes="muted" />
                            <TextBlock Name="ModeLabel" Text="Manual" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Button Name="SwitchModeButton" Content="Switch mode" Classes="quiet" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,320" ColumnSpacing="16" Margin="0,0,0,12">
            <!-- The canvas retains its original coordinate system and node hit areas. -->
            <Border Classes="card">
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                    <Grid ColumnDefinitions="*,Auto" Margin="20,18,20,14">
                        <StackPanel Spacing="5">
                            <TextBlock Text="YOUR WORKSPACE" Classes="eyebrow" />
                            <TextBlock Text="Make the connections." FontSize="21" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1" Name="ResetButton" Content="Reset nodes" Classes="quiet" VerticalAlignment="Center" />
                    </Grid>
                    <Border Grid.Row="1" Margin="12,0" CornerRadius="10" Background="{StaticResource WarmSurface}" ClipToBounds="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <controls:GraphCanvas Name="GraphCanvas" MinWidth="680" MinHeight="380" Background="{StaticResource WarmSurface}" />
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Row="2" Margin="20,12,20,0" Padding="0,14" BorderBrush="{StaticResource WarmBorder}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="12">
                            <StackPanel Name="StatsPanel" Orientation="Horizontal" Spacing="20">
                                <TextBlock Name="NodeCountText" Text="Nodes: 0" Classes="muted" />
                                <TextBlock Name="ConnectionCountText" Text="Connections: 0" Classes="muted" />
                                <TextBlock Name="ShortestPathText" Text="Last Path Length: -" Classes="muted" />
                            </StackPanel>
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="Drag nodes to arrange" Classes="muted" Margin="0,0,22,0" />
                                <TextBlock Text="Right-click a node to edit connections" Classes="muted" />
                            </WrapPanel>
                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,0">
                                    <Ellipse Width="8" Height="8" Fill="Red" VerticalAlignment="Center" />
                                    <TextBlock Text="Exploring" Classes="muted" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,0">
                                    <Ellipse Width="8" Height="8" Fill="Orange" VerticalAlignment="Center" />
                                    <TextBlock Text="Alternative" Classes="muted" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,0">
                                    <Ellipse Width="8" Height="8" Fill="Green" VerticalAlignment="Center" />
                                    <TextBlock Text="Best path" Classes="muted" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="Yellow" Stroke="#9B7E2F" StrokeThickness="1" VerticalAlignment="Center" />
                                    <TextBlock Text="Final solution" Classes="muted" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Expander Grid.Row="3" Header="Adjacency matrix" Margin="12,0,12,12" HorizontalAlignment="Stretch">
                        <DataGrid Name="AdjacencyMatrix" Height="150" IsReadOnly="True" CanUserResizeColumns="False"
                                  GridLinesVisibility="All" HeadersVisibility="All"
                                  Background="{StaticResource WarmSurface}" BorderBrush="{StaticResource WarmBorder}" />
                    </Expander>
                </Grid>
            </Border>

            <!-- All original controls stay in the same namescope for code-behind. -->
            <Grid Grid.Column="1" RowDefinitions="*,190" RowSpacing="12">
                <Border Classes="card" Padding="18">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <TextBlock Text="EXPLORE AN ALGORITHM" Classes="eyebrow" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                <Button Name="BFSButton" Content="BFS" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Name="DFSButton" Content="DFS" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="2" Name="DijkstraButton" Content="Dijkstra" Padding="8,9" HorizontalAlignment="Stretch" />
                            </Grid>
                            <StackPanel Spacing="6">
                                <Button Name="TSPButton" Content="TSP Brute Force" HorizontalAlignment="Stretch" />
                                <Button Name="NearestNeighbourButton" Content="TSP Nearest Neighbour" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource WarmBorder}" />
                            <TextBlock Text="Choose your route" Classes="sectionTitle" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="7">
                                <TextBlock Text="Source" Classes="muted" />
                                <TextBlock Grid.Column="1" Text="Target" Classes="muted" />
                                <ComboBox Grid.Row="1" Name="SourceNodeCombo" AutomationProperties.Name="Source node" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Name="TargetNodeCombo" AutomationProperties.Name="Target node" />
                                <Button Grid.Row="2" Name="SetSourceButton" Content="Set source" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="2" Grid.Column="1" Name="SetTargetButton" Content="Set target" HorizontalAlignment="Stretch" />
                            </Grid>
                            <Button Name="FindPathButton" Content="Find shortest path" Classes="primary" HorizontalAlignment="Stretch" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Animation delay" Classes="muted" />
                                <TextBlock Grid.Column="1" Name="SpeedLabel" Text="500ms" FontSize="12" FontWeight="SemiBold" />
                            </Grid>
                            <Slider Name="SpeedSlider" Minimum="100" Maximum="2000" Value="500"
                                    AutomationProperties.Name="Animation delay in milliseconds" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Border Grid.Row="1" Classes="card" Padding="18">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                        <TextBlock Text="Algorithm output" Classes="sectionTitle" />
                        <Border Grid.Row="1" Background="{StaticResource WarmBackground}" CornerRadius="8" Padding="12">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <TextBlock Name="AlgorithmOutput" TextWrapping="Wrap" FontSize="12" LineHeight="20" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{StaticResource WarmBorder}" BorderThickness="0,1,0,0" Padding="2,11">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse Width="6" Height="6" Fill="#6E7953" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Name="StatusText" Text="Ready" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="GRAPH THEORY TEACHING AID" Classes="eyebrow" Margin="16,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
